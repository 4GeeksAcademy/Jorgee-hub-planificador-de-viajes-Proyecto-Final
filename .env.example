# Copia este archivo como .env y reemplaza los valores de ejemplo.
# No subas .env al repositorio.

# Back end / Flask
FLASK_APP=src/app.py
FLASK_DEBUG=1
# En Linux, esta forma usa el usuario local y el socket de PostgreSQL.
DATABASE_URL=postgresql:///planificador_viajes_dev
# Alternativa TCP si tu PostgreSQL requiere usuario/contraseña:
# DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_PASSWORD@localhost:5432/planificador_viajes_dev

# Front end / Vite
VITE_BASENAME=/
VITE_BACKEND_URL=http://127.0.0.1:3001
